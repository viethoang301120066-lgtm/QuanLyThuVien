<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Sửa "Data Source" cho đúng tên SQL Server trên máy bạn, ví dụ:
         Data Source=.            (bản Developer / mặc định)
         Data Source=.\SQLEXPRESS (bản Express)
         Data Source=(localdb)\MSSQLLocalDB -->
    <add name="QuanLyThuVien"
         connectionString="Data Source=.;Initial Catalog=QuanLyThuVien;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
